  <diagram id="2-·-auto-plot-logic" name="2 · Auto Plot logic">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="x1" value="&lt;b&gt;Auto Plot — how the roster is worked out&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt;autoPlot() → buildOnePlan() → scorePlan()  ·  randomised search: many complete plans are built, each is scored, the lowest score wins&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="16" width="1300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Click “Auto Plot”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="90" y="90" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="&lt;b&gt;Compulsory starters valid?&lt;/b&gt;&lt;br&gt;no person twice · no keep-apart&lt;br&gt;pair on the same day-1 shift" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="40" y="160" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="&lt;b&gt;Stop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;status line says exactly&lt;br&gt;what to fix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="360" y="180" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="&lt;b&gt;Prepare the month&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;list of dates · starters on leave on&lt;br&gt;day 1 are placed normally instead&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="40" y="300" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="&lt;b&gt;Choose rotation patterns&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Auto: 3-on/3-off, 2-on/2-off, mixed → 12 plans each&lt;br&gt;Fixed pattern: 40 plans&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="40" y="395" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="&lt;b&gt;Build one complete plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;buildOnePlan()  — see right&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="40" y="495" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="&lt;b&gt;Score the plan&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;scorePlan()  — lower is better&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="40" y="580" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q9" value="&lt;b&gt;Lower than best so far?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="70" y="665" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b10" value="&lt;b&gt;Keep as best&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
