        <mxCell id="x1" value="&lt;b&gt;Schedule Master — system architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt;Monthly staff shift roster · single-file HTML/JS client · Python standard-library server · nginx/HTTPS on a Linux VM&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="16" width="1100" height="50" as="geometry" />
