        <mxCell id="b12" value="&lt;b&gt;Refine the winning pattern&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;40 more plans (Auto) / 20 (fixed)&lt;br&gt;keep the best overall&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
