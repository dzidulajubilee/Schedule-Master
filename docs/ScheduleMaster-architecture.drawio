        </mxCell>
        <mxCell id="e26" value="yes · next plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="q11" target="b7">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="810" />
              <mxPoint x="20" y="525" />
