        <mxCell id="m6_98" value="14" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=right;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="m6_47">
