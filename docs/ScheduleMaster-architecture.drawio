        <mxCell id="q11" value="&lt;b&gt;More attempts left?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontFamily=Helvetica;" parent="1" vertex="1">
