        <mxCell id="g31" value="Leave rules" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" parent="1" vertex="1">
