  </diagram>
  <diagram id="m5_page" name="5 · The math (formulas)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="m5_1" value="&lt;b&gt;Auto Plot — the math&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt;Every formula is taken from ScheduleMaster.html · symbols: q = quota, u = shifts given, s = spare quota (q − u), n = people on a shift, E = expected shifts, L = leave days, W = weekend days · [x] = 1 if x is true, else 0&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="14" width="1500" height="56" as="geometry" />
        </mxCell>
        <mxCell id="m5_2" value="1 · Quota (quotaFor)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="90" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="m5_3" value="$$q_p = \max\bigl(0,\; E - L_p\bigr) \qquad s_p = q_p - u_p$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=15;fontFamily=Helvetica;" vertex="1" parent="m5_2">
          <mxGeometry x="10" y="40" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m5_4" value="L&lt;sub&gt;p&lt;/sub&gt; counts leave in the month being planned; Saturdays and Sundays are left out when “weekend leave doesn't reduce quota” is on (default).&lt;br&gt;Example: Esi, 2 weekday leave days → q = 14 − 2 = 12.&lt;br&gt;Nobody with s&lt;sub&gt;p&lt;/sub&gt; = 0 is given another shift by Auto Plot or Manual Plot." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_2">
          <mxGeometry x="15" y="120" width="490" height="120" as="geometry" />
        </mxCell>
        <mxCell id="m5_5" value="2 · Daily demand: minimum and target" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="90" width="540" height="250" as="geometry" />
        </mxCell>
        <mxCell id="m5_6" value="$$\min_{t,d} = \begin{cases} \text{weTarget}_t &amp; d \in W \\ \text{wdMin}_t &amp; d \notin W,\ t \text{ flexible} \\ \text{wdTarget}_t &amp; d \notin W,\ t \text{ strict} \end{cases}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m5_5">
          <mxGeometry x="10" y="38" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m5_7" value="$$\text{target}_{t,d} = \begin{cases} \text{weTarget}_t &amp; d \in W \\ \text{wdTarget}_t &amp; d \notin W \end{cases}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m5_5">
          <mxGeometry x="10" y="128" width="520" height="66" as="geometry" />
        </mxCell>
        <mxCell id="m5_8" value="Defaults: Day (flexible) weekday min 1, target 2, weekend 2 · Night (strict) 2 / 2 / 2" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_5">
          <mxGeometry x="15" y="205" width="510" height="36" as="geometry" />
        </mxCell>
        <mxCell id="m5_9" value="3 · Supply vs demand — is the month possible?" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1150" y="90" width="520" height="250" as="geometry" />
        </mxCell>
        <mxCell id="m5_10" value="$$\text{Supply} = \sum_{p} q_p \qquad \text{Demand}_{\min} = \sum_{d}\sum_{t} \min_{t,d}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m5_9">
          <mxGeometry x="10" y="36" width="500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m5_11" value="$$\text{Sep 2026: } 22 \times (1+2) + 8 \times (2+2) = 98 \qquad 30 \times 4 = 120$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="m5_9">
          <mxGeometry x="10" y="96" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m5_12" value="Supply &amp;lt; 98 → gaps unavoidable (≥ 1,000,000 penalty)&lt;br&gt;98 ≤ Supply &amp;lt; 120 → minimum met, (120 − Supply) × 300 below target&lt;br&gt;Supply ≥ 120 → all targets can be met&lt;br&gt;&lt;b&gt;Team size:&lt;/b&gt; ≥ 98 / 14 = 7 people for the minimum, ≥ 120 / 14 ≈ 8.6 → 9 for the target" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_9">
          <mxGeometry x="15" y="140" width="495" height="105" as="geometry" />
        </mxCell>
        <mxCell id="m5_13" value="4 · Rotation blocks and carry-over (blockLenFor, seedCarryover)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="370" width="520" height="260" as="geometry" />
        </mxCell>
        <mxCell id="m5_14" value="$$b = \begin{cases} 3 &amp; \text{3 on / 3 off} \\ 2 &amp; \text{2 on / 2 off} \\ b \sim \text{Uniform}\{2,3\} &amp; \text{mixed} \end{cases}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m5_13">
          <mxGeometry x="10" y="36" width="500" height="86" as="geometry" />
        </mxCell>
        <mxCell id="m5_15" value="$$\text{rest owed} = \max(0,\; b - \rho)$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m5_13">
          <mxGeometry x="10" y="124" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m5_16" value="b days on the same type, then b days off. Carry-over looks back up to 7 days into last month:&lt;br&gt;worked the last day, run r: r ≥ b → owes b days off, else continues b − r more days;&lt;br&gt;off the last day for ρ days → owes max(0, b − ρ)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_13">
          <mxGeometry x="15" y="168" width="495" height="86" as="geometry" />
        </mxCell>
        <mxCell id="m5_17" value="5 · Rest hours (restGapHours)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="580" y="370" width="540" height="260" as="geometry" />
        </mxCell>
        <mxCell id="m5_18" value="$$\text{rest}(A \to B) = (\text{start}_B + 24) - \text{end}'_A$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m5_17">
          <mxGeometry x="10" y="38" width="520" height="44" as="geometry" />
        </mxCell>
        <mxCell id="m5_19" value="$$\text{end}'_A = \begin{cases} \text{end}_A + 24 &amp; \text{end}_A \le \text{start}_A \\ \text{end}_A &amp; \text{otherwise} \end{cases}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m5_17">
          <mxGeometry x="10" y="84" width="520" height="66" as="geometry" />
        </mxCell>
        <mxCell id="m5_20" value="Day 07–19 → Night next day: (19 + 24) − 19 = &lt;b&gt;24 h&lt;/b&gt;&lt;br&gt;Night 19–07 → Day next day: (7 + 24) − (7 + 24) = &lt;b&gt;0 h&lt;/b&gt;&lt;br&gt;That is why a shift-type change between back-to-back days is never allowed — the no-flip rule is what actually guarantees rest." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_17">
          <mxGeometry x="15" y="158" width="510" height="96" as="geometry" />
        </mxCell>
        <mxCell id="m5_21" value="6 · Phase 1 — who gets picked" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1150" y="370" width="520" height="260" as="geometry" />
        </mxCell>
        <mxCell id="m5_22" value="$$\begin{aligned} \text{eligible} =\;&amp; \neg\text{leave} \wedge \neg\text{working} \wedge (u_p \lt q_p) \\ &amp;\wedge \text{keepApartOK} \wedge (\text{rest owed} = 0) \wedge \neg\text{midBlockOther} \end{aligned}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="m5_21">
          <mxGeometry x="10" y="36" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m5_23" value="$$\text{priority}_p = (q_p - u_p) + \varepsilon_p - 0.15\, u_{p,t}, \quad \varepsilon_p \sim U(0,\,0.5)$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="m5_21">
          <mxGeometry x="10" y="110" width="500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m5_24" value="Highest priority first. Spare quota dominates: the random part is at most 0.5, so 1 extra spare shift is only overturned by a type gap of 4 or more (0.15 × 4 = 0.6).&lt;br&gt;Among equal spare quota, chance mostly decides — that is what makes every attempt different." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_21">
          <mxGeometry x="15" y="164" width="495" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m5_25" value="7 · Phase 2 — top up spare quota (pass 1: to minimum · pass 2: to target)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="660" width="800" height="220" as="geometry" />
        </mxCell>
        <mxCell id="m5_26" value="$$\forall d \in [i,\, i+b):\; n_{t,d} \lt \text{cap}_{t,d} \,\wedge\, \text{free}_{p,d} \,\wedge\, \text{keepApartOK}_{p,t,d} \qquad \text{cap} = \begin{cases} \min_{t,d} &amp; \text{pass 1} \\ \text{target}_{t,d} &amp; \text{pass 2} \end{cases}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="m5_25">
          <mxGeometry x="10" y="36" width="780" height="76" as="geometry" />
        </mxCell>
        <mxCell id="m5_27" value="People by spare quota (largest first); for each, the shift type they have fewest of first.&lt;br&gt;Run length b = min(ideal block, s&lt;sub&gt;p&lt;/sub&gt;) down to 1 · rest gap g = b, then g = 1 · one valid window chosen at random." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_25">
          <mxGeometry x="15" y="120" width="770" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m5_28" value="8 · Phase 3 — even it out" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="860" y="660" width="810" height="220" as="geometry" />
        </mxCell>
        <mxCell id="m5_29" value="$$\begin{aligned} &amp;(u_o - q_o \ge 2) \wedge (q_v - u_v \ge 1) \wedge t\ \text{flexible} \wedge d\ \text{block edge or lone day} \\ &amp;\wedge \text{free}_{v,d} \wedge \text{keepApartOK}_{v,t,d} \wedge \text{no flip} \wedge \text{run}_v \le 3 \end{aligned}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="m5_28">
          <mxGeometry x="10" y="36" width="790" height="76" as="geometry" />
        </mxCell>
        <mxCell id="m5_30" value="Moves one day from the most over-quota person o to the most under-quota person v, up to 300 moves.&lt;br&gt;&lt;b&gt;In practice it essentially never fires:&lt;/b&gt; Phases 1–2 stop at each person's quota (only a compulsory starter can go 1 over), so u&lt;sub&gt;o&lt;/sub&gt; − q&lt;sub&gt;o&lt;/sub&gt; ≥ 2 is not reached." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_28">
          <mxGeometry x="15" y="120" width="780" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m5_31" value="9 · The score (scorePlan) — lower is better" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="910" width="1000" height="460" as="geometry" />
        </mxCell>
        <mxCell id="m5_32" value="$$\begin{aligned} \text{score} =\;&amp; 10^6 \sum_{d,t} [\,n_{t,d} \lt \min_{t,d}\,] + 300 \sum_{d,t} [\,\min_{t,d} \le n_{t,d} \lt \text{target}_{t,d}\,] + 100 \sum_{d,t} [\,n_{t,d} \gt \text{target}_{t,d}\,] \\ &amp;+ 10^6 \sum_{\text{pairs},d} [\text{same shift, weekend or marked type}] + 3000 \sum_{\text{pairs},d} [\text{same shift, weekday unmarked type}] \\ &amp;+ 2000 \sum_{p,d} [\text{type flip}] + 4000 \sum_{p,d} [\text{run} \gt 3] + 10^5 \sum_p [\,u_p \gt 0 \text{ and } p \text{ lacks a type}\,] \\ &amp;+ 220\,\bigl(\max_p s_p - \min_p s_p\bigr) + 30\,\operatorname{Var}(s) + 40 \sum_{p} \bigl(\max_t u_{p,t} - \min_t u_{p,t}\bigr) \end{aligned}$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m5_31">
          <mxGeometry x="10" y="40" width="980" height="250" as="geometry" />
        </mxCell>
        <mxCell id="m5_33" value="The 10&lt;sup&gt;5&lt;/sup&gt; term applies only when “every person works every shift type” is on. Var(s) is the population variance of spare quota. A 5-day run costs 2 × 4,000.&lt;br&gt;&lt;b&gt;What the spacing means:&lt;/b&gt; one coverage gap (1,000,000) outweighs 250 over-long run days · one below-target shift (300) outweighs widening the workload range by one (220) · 8 shifts of Day/Night imbalance (320) outweigh one below-target shift." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m5_31">
          <mxGeometry x="15" y="300" width="970" height="150" as="geometry" />
        </mxCell>
        <mxCell id="m5_34" value="Weights" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1060" y="910" width="610" height="460" as="geometry" />
        </mxCell>
        <mxCell id="m5_35" value="Term" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="m5_34">
          <mxGeometry x="15" y="45" width="330" height="36" as="geometry" />
        </mxCell>
        <mxCell id="m5_36" value="Weight" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="m5_34">
          <mxGeometry x="345" y="45" width="120" height="36" as="geometry" />
