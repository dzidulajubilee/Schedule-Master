        </mxCell>
        <mxCell id="m6_100" value="6" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=right;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="m6_47">
          <mxGeometry x="285" y="333" width="60" height="36" as="geometry" />
        </mxCell>
        <mxCell id="m6_101" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;align=right;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontFamily=Helvetica;" vertex="1" parent="m6_47">
          <mxGeometry x="345" y="333" width="60" height="36" as="geometry" />
        </mxCell>
        <mxCell id="m6_102" value="Why exactly 10 below target (3,000 points — unavoidable)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1070" y="90" width="600" height="205" as="geometry" />
        </mxCell>
        <mxCell id="m6_103" value="$$\text{Night: } 2 \times 30 = 60 \qquad \text{Supply} = 7 \times 14 + 12 = 110 \qquad \text{Day gets } 110 - 60 = 50$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="m6_102">
          <mxGeometry x="10" y="36" width="580" height="44" as="geometry" />
        </mxCell>
        <mxCell id="m6_104" value="$$\text{Day target } 22 \times 2 + 8 \times 2 = 60 \;\Rightarrow\; 60 - 50 = 10 \text{ short} \times 300 = 3000$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="m6_102">
          <mxGeometry x="10" y="82" width="580" height="44" as="geometry" />
        </mxCell>
        <mxCell id="m6_105" value="10 weekdays can only have 1 Day person with this team, whatever the plan." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m6_102">
          <mxGeometry x="15" y="140" width="570" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m6_106" value="Why 560 (Day/Night balance)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1070" y="305" width="600" height="205" as="geometry" />
        </mxCell>
        <mxCell id="m6_107" value="$$14 \text{ shifts} = 7 \text{ blocks of } 2 \Rightarrow 3 + 4 \text{ blocks} = 6 / 8 \text{ split} \Rightarrow 7 \times 2 \times 40 = 560$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="m6_106">
          <mxGeometry x="10" y="36" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m6_108" value="Esi: 12 shifts = 6 blocks → 3 + 3 → balance 0. With full 2-day blocks 3,560 is the floor for 2 on / 2 off; mixed 2/3 blocks can split 14 as 7 + 7, so it can go lower." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m6_106">
          <mxGeometry x="15" y="96" width="570" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m6_109" value="The search — expected best score after k attempts (200 plans per pattern)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="30" y="540" width="1010" height="640" as="geometry" />
        </mxCell>
        <mxCell id="m6_110" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/png,;" vertex="1" parent="m6_109">
          <mxGeometry x="15" y="45" width="980" height="532" as="geometry" />
        </mxCell>
        <mxCell id="m6_111" value="Measured in a test copy of ScheduleMaster.html; the chart is an image of the one in the Docs version." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;fontFamily=Helvetica;" vertex="1" parent="m6_109">
          <mxGeometry x="15" y="590" width="980" height="30" as="geometry" />
        </mxCell>
        <mxCell id="m6_112" value="What the search numbers mean" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1070" y="540" width="600" height="640" as="geometry" />
        </mxCell>
        <mxCell id="m6_113" value="$$\text{plan}^{*} = \arg\min_{P_1 \dots P_{76}} \text{score} \qquad 76 = 3 \times 12 + 40$$" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="m6_112">
          <mxGeometry x="10" y="40" width="580" height="50" as="geometry" />
        </mxCell>
        <mxCell id="m6_114" value="&lt;b&gt;Budget:&lt;/b&gt; 12 attempts per pattern, then 40 more for the leader (fixed pattern: 40 + 20 = 60).&lt;br&gt;&lt;br&gt;&lt;b&gt;After 12 attempts&lt;/b&gt; the expected best was 4,040 (3 on / 3 off), 3,580 (2 on / 2 off) and 3,528 (mixed) — close enough that the first-round winner is partly luck, and the loser gets no refinement.&lt;br&gt;&lt;br&gt;&lt;b&gt;This run:&lt;/b&gt; 2 on / 2 off won and finished at 3,560. Mixed with the same 52 attempts would expect about 3,420; the best mixed plan seen scored 3,400.&lt;br&gt;&lt;br&gt;&lt;b&gt;The gap:&lt;/b&gt; 160 points = 4 shifts of Day/Night imbalance (160 / 40). Coverage, rest and quota were identical; the 3,000 below-target points are fixed by team size.&lt;br&gt;&lt;br&gt;&lt;b&gt;One attempt is never trusted:&lt;/b&gt; 74 of 200 single 3 on / 3 off plans scored over 100,000 (someone got only one shift type)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" vertex="1" parent="m6_112">
          <mxGeometry x="15" y="100" width="570" height="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>