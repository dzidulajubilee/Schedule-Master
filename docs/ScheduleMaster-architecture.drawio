        </mxCell>
        <mxCell id="b32" value="&lt;b&gt;Leave blocks placement&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Auto Plot and Manual Plot never place a shift on a leave day&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g31" vertex="1">
          <mxGeometry x="15" y="45" width="390" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b33" value="&lt;b&gt;Leave reduces the month's quota&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;quota = expected shifts − leave days in that month&lt;br&gt;weekend leave optionally not counted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g31" vertex="1">
          <mxGeometry x="15" y="115" width="390" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b34" value="&lt;b&gt;Weekend between leave days is added&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Fri + Mon → Sat, Sun · Fri + Sun → Sat · Sat + Mon → Sun&lt;br&gt;(only when the gap is entirely weekend)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g31" vertex="1">
