        <mxCell id="x19" value="&lt;b&gt;Request path&lt;/b&gt;&lt;br&gt;1. Browser loads ScheduleMaster.html over HTTPS (:443)&lt;br&gt;2. Sign-in → session cookie&lt;br&gt;3. Page talks JSON to /api/* with that cookie&lt;br&gt;4. Server reads/writes the JSON data files&lt;br&gt;5. Send → server builds each person's email → Postfix → their inbox" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="480" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="b20" value="&lt;b&gt;Staff (email recipients)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Get only their own shifts:&lt;br&gt;email body + PDF calendar + .ics file&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="850" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="b21" value="&lt;b&gt;Recipients' mail servers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Internet / company mail&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="30" y="960" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="g22" value="Browser — ScheduleMaster.html  (single file · HTML + CSS + vanilla JavaScript)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#dae8fc;swimlaneFillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="370" y="90" width="640" height="730" as="geometry" />
        </mxCell>
        <mxCell id="b23" value="&lt;b&gt;User interface panels&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;1 Staff · 2 Shift types · 3 Rules &amp; settings · 4 Keep-apart pairs&lt;br&gt;5 Leave · 6 Manual Plot · 7 Compulsory starters · Calendar&lt;br&gt;Workload · Coverage check · Saved records · Email&lt;br&gt;10 colour schemes · light/dark · Print / PDF stylesheet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g22" vertex="1">
          <mxGeometry x="20" y="45" width="600" height="110" as="geometry" />
        </mxCell>
        <mxCell id="g24" value="Planning engine — “the thinking” (runs entirely in the browser)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=12;container=1;collapsible=0;fontFamily=Helvetica;" parent="g22" vertex="1">
          <mxGeometry x="20" y="175" width="600" height="250" as="geometry" />
        </mxCell>
        <mxCell id="b25" value="&lt;b&gt;Auto Plot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;tries ~76 candidate plans, keeps the best score&lt;br&gt;Phases 0–3 + scoring (page 2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g24" vertex="1">
          <mxGeometry x="15" y="42" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b26" value="&lt;b&gt;Manual Plot rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;canPlaceShift(): leave, no type flip,&lt;br&gt;keep-apart, quota (page 3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g24" vertex="1">
          <mxGeometry x="210" y="42" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b27" value="&lt;b&gt;Quota&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;quotaFor(): expected shifts&lt;br&gt;− leave days this month&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g24" vertex="1">
          <mxGeometry x="405" y="42" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b28" value="&lt;b&gt;Coverage check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gaps below minimum cover,&lt;br&gt;keep-apart shares&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g24" vertex="1">
          <mxGeometry x="15" y="140" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b29" value="&lt;b&gt;Workload&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;per-person totals by shift type,&lt;br&gt;quota, leave, longest run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g24" vertex="1">
          <mxGeometry x="210" y="140" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="b30" value="&lt;b&gt;Leave rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;blocks placement · reduces quota&lt;br&gt;weekend between leave days&lt;br&gt;added automatically&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g24" vertex="1">
          <mxGeometry x="405" y="140" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d31" value="&lt;b&gt;Browser state  S&lt;/b&gt;&lt;br&gt;localStorage&lt;br&gt;shifts · leave · settings · colour scheme" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;fontFamily=Helvetica;" parent="g22" vertex="1">
          <mxGeometry x="20" y="445" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b32" value="&lt;b&gt;Safety in the page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;in-app confirmation dialog&lt;br&gt;esc(): names shown as text, never code&lt;br&gt;sign-in overlay&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g22" vertex="1">
          <mxGeometry x="225" y="445" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="b33" value="&lt;b&gt;API client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;fetch + session cookie&lt;br&gt;/api/staff · /api/records&lt;br&gt;/api/emails · /api/send-shifts&lt;br&gt;/api/login · logout · session&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g22" vertex="1">
          <mxGeometry x="430" y="445" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="x34" value="&lt;b&gt;Shared vs. per-browser:&lt;/b&gt; staff list, saved records and email addresses live on the server (shared by everyone who signs in). The working roster — shifts, leave, settings — lives in each browser's localStorage. Saved records are frozen server-side snapshots: removing a staff member never changes them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" parent="g22" vertex="1">
          <mxGeometry x="20" y="580" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="x35" value="&lt;b&gt;Local / test mode:&lt;/b&gt; &lt;i&gt;python3 ScheduleMaster.py&lt;/i&gt; serves on 127.0.0.1:8743 and opens the browser (no nginx). Same page, same API." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" parent="g22" vertex="1">
          <mxGeometry x="20" y="660" width="600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="g36" value="Linux VM  (installed by install.sh)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="1090" y="90" width="590" height="1020" as="geometry" />
        </mxCell>
        <mxCell id="b37" value="&lt;b&gt;nginx  (ports 80 → 443)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;HTTPS with self-signed certificate · port 80 redirects to HTTPS&lt;br&gt;Only private address ranges allowed by default (--allow to widen)&lt;br&gt;Rate limit on /api/login · sets X-Forwarded-For&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g36" vertex="1">
          <mxGeometry x="20" y="45" width="550" height="95" as="geometry" />
        </mxCell>
        <mxCell id="g38" value="systemd service “schedulemaster”" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#e1d5e7;swimlaneFillColor=#ffffff;strokeColor=#9673a6;fontStyle=1;fontSize=12;container=1;collapsible=0;fontFamily=Helvetica;" parent="g36" vertex="1">
          <mxGeometry x="20" y="190" width="550" height="565" as="geometry" />
        </mxCell>
        <mxCell id="b39" value="Runs as its own system user · NoNewPrivileges · ProtectSystem=strict · ProtectHome · PrivateTmp · can write only to the app folder" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g38" vertex="1">
          <mxGeometry x="15" y="40" width="520" height="42" as="geometry" />
        </mxCell>
        <mxCell id="g40" value="ScheduleMaster.py — Python 3 standard library · ThreadingHTTPServer · 127.0.0.1:8766" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=11;container=1;collapsible=0;fontFamily=Helvetica;" parent="g38" vertex="1">
          <mxGeometry x="15" y="95" width="520" height="455" as="geometry" />
        </mxCell>
        <mxCell id="b41" value="&lt;b&gt;Static page&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;only ScheduleMaster.html&lt;br&gt;everything else → 404&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g40" vertex="1">
          <mxGeometry x="15" y="42" width="155" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b42" value="&lt;b&gt;Sign-in &amp; sessions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;login.json · 30-day cookie&lt;br&gt;5 wrong tries → 15-min lock&lt;br&gt;constant-time check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g40" vertex="1">
          <mxGeometry x="180" y="42" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b43" value="&lt;b&gt;JSON API routes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;data routes need a session&lt;br&gt;atomic file writes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g40" vertex="1">
          <mxGeometry x="350" y="42" width="155" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b44" value="&lt;b&gt;Records versioning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;fingerprint of records.json&lt;br&gt;stale save → 409, nothing written&lt;br&gt;one write at a time&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g40" vertex="1">
          <mxGeometry x="15" y="135" width="235" height="82" as="geometry" />
        </mxCell>
        <mxCell id="b45" value="&lt;b&gt;Email On/Off&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;emails.json “paused” list&lt;br&gt;server skips people turned Off&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g40" vertex="1">
          <mxGeometry x="260" y="135" width="245" height="82" as="geometry" />
        </mxCell>
        <mxCell id="g46" value="Email builder (per person, only their own dates)" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#d5e8d4;swimlaneFillColor=#ffffff;strokeColor=#82b366;fontStyle=1;fontSize=11;container=1;collapsible=0;fontFamily=Helvetica;" parent="g40" vertex="1">
          <mxGeometry x="15" y="232" width="490" height="145" as="geometry" />
        </mxCell>
        <mxCell id="b47" value="&lt;b&gt;Text + HTML body&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;selected scheme colours&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g46" vertex="1">
          <mxGeometry x="10" y="40" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b48" value="&lt;b&gt;PDF calendar&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;built-in writer · A4&lt;br&gt;exact scheme colours&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g46" vertex="1">
          <mxGeometry x="170" y="40" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b49" value="&lt;b&gt;.ics calendar file&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;timed shifts · all-day leave&lt;br&gt;stable IDs → updates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g46" vertex="1">
          <mxGeometry x="330" y="40" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="x50" value="Shifts_YYYY-MM_&amp;lt;Full Name&amp;gt;.pdf / .ics" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#333333;fontFamily=Helvetica;" parent="g46" vertex="1">
          <mxGeometry x="10" y="110" width="400" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b51" value="&lt;b&gt;SMTP client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one connection per batch · reconnect once if dropped&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g40" vertex="1">
