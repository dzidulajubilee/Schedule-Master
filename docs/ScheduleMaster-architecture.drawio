        </mxCell>
        <mxCell id="e27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="q11" target="b12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="b12" target="b13">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;fontFamily=Helvetica;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="b13" target="t14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="g30" value="buildOnePlan()  — one complete candidate roster" style="swimlane;html=1;whiteSpace=wrap;rounded=1;arcSize=2;startSize=30;fillColor=#ffe6cc;swimlaneFillColor=#ffffff;strokeColor=#d79b00;fontStyle=1;fontSize=13;container=1;collapsible=0;fontFamily=Helvetica;" parent="1" vertex="1">
          <mxGeometry x="540" y="90" width="640" height="1060" as="geometry" />
        </mxCell>
        <mxCell id="b31" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;&lt;b&gt;Quota&lt;/b&gt; per person = expected shifts − leave days in this month&lt;br&gt;(weekend leave not counted if “weekend leave doesn't reduce quota” is on)&lt;br&gt;&lt;b&gt;Needed per shift per day&lt;/b&gt;: weekend → weekend target;&lt;br&gt;weekday → minimum (flexible type) or target (strict type)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="45" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="b32" value="&lt;b&gt;Carry-over from last month&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;reads the last days of the previous month already on the calendar:&lt;br&gt;an unfinished block continues · a finished block owes its rest days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="165" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b33" value="&lt;b&gt;Phase 0 — Compulsory starters&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;up to 4 people forced onto day 1 on their chosen shift, then a normal block starts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="255" width="600" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b34" value="&lt;b&gt;Phase 1 — Minimum cover, day by day&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;strict shift types first, then flexible ones&lt;br&gt;① continue blocks already running   ② start new blocks until the day's need is met&lt;br&gt;ranked by spare quota + small random factor − nudge if they already have many of this type&lt;br&gt;block length: 3 (3-on/3-off), 2 (2-on/2-off) or random 2/3 (mixed) · then the same number of rest days&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="335" width="600" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b35" value="&lt;b&gt;Phase 2 — Top up spare quota (pass 1 up to minimum, pass 2 up to target)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;people with the most spare quota first · the shift type they have fewest of first&lt;br&gt;whole block if possible, else shorter runs so nobody is stranded under quota&lt;br&gt;prefer a full rest gap either side, else a 1-day gap · a random valid window is picked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="470" width="600" height="105" as="geometry" />
        </mxCell>
        <mxCell id="b36" value="&lt;b&gt;Phase 3 — Even it out&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;move one flexible-shift day from the most over-quota person (≥ 2 over)&lt;br&gt;to the most under-quota person (≥ 1 under) — only at the edge of a block or a lone day;&lt;br&gt;receiver must be free, keep-apart OK, no shift-type flip, run ≤ 3 days · up to 300 moves&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="595" width="600" height="100" as="geometry" />
        </mxCell>
        <mxCell id="t37" value="Plan → scorePlan()" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="220" y="715" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="x38" value="&lt;b&gt;Rules every phase applies&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="785" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="b39" value="&lt;b&gt;Who is eligible for a slot&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;✓ not on leave   ✓ not already working that day   ✓ under quota&lt;br&gt;✓ keep-apart allowed   ✓ not in a rest period   ✓ not mid-block on another type&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="810" width="600" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b40" value="&lt;b&gt;Keep-apart rule (pairs set in panel 4)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;same shift on a &lt;b&gt;weekend&lt;/b&gt;, or on a shift type marked keep-apart → &lt;b&gt;hard&lt;/b&gt;: never placed&lt;br&gt;same weekday shift on an unmarked type → &lt;b&gt;soft&lt;/b&gt;: allowed, but penalised in the score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=middle;spacing=6;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="895" width="600" height="75" as="geometry" />
        </mxCell>
        <mxCell id="x41" value="Randomness (tie-breaks, block lengths, window choice) is why each attempt differs — the search keeps whichever attempt scores lowest." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;fontFamily=Helvetica;" parent="g30" vertex="1">
          <mxGeometry x="20" y="990" width="600" height="40" as="geometry" />
        </mxCell>
